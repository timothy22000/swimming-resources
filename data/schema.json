{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/timothy22000/swimming-resources/blob/main/data/schema.json",
  "title": "Swimming Resource",
  "description": "Schema for a single entry in the Swimming Resources Database.",
  "type": "object",
  "required": [
    "id", "category", "name", "type", "audience", "description", "url",
    "pricing", "region", "language", "status", "tags", "verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+[0-9]*-[0-9]{3,4}$",
      "description": "Stable unique identifier formatted as <prefix>-NNN."
    },
    "category": {
      "type": "string",
      "enum": [
        "governing_bodies", "learn_to_swim", "technique", "youtube",
        "training_plans", "apps", "books", "certifications", "science",
        "news", "podcasts", "gear", "open_water", "triathlon", "masters",
        "para", "drowning_prevention", "records", "college", "recruiting"
      ]
    },
    "subcategory": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "pricing": {
      "type": "string",
      "enum": ["free", "paid", "freemium", "mixed", "varies"]
    },
    "region": { "type": "string", "minLength": 1 },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "ISO 639-1 primary language code."
    },
    "year_founded": {
      "type": ["integer", "null"],
      "minimum": 1700,
      "maximum": 2100
    },
    "status": {
      "type": "string",
      "enum": ["active", "rebranded", "defunct"]
    },
    "notes": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "Date the URL was last verified (YYYY-MM)."
    }
  },
  "additionalProperties": false
}
